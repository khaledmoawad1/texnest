# TeXnest — Overleaf Community Edition settings (loaded into the sharelatex container).
# Personal values and secrets go in local.env (git-ignored), which overrides this file.

OVERLEAF_APP_NAME="TeXnest"
OVERLEAF_NAV_TITLE=TeXnest
OVERLEAF_HEADER_IMAGE_URL=/img/texnest.svg
OVERLEAF_SITE_URL=http://localhost
OVERLEAF_ADMIN_EMAIL=admin@example.com

# Footer links (Community Edition itself already prints "Powered by Overleaf" and
# its trademark disclaimer). The source link is what the AGPL asks of a network service.
OVERLEAF_LEFT_FOOTER='[{"text":"TeXnest on GitHub","url":"https://github.com/khaledmoawad1/texnest"},{"text":"Source code (AGPL-3.0)","url":"https://github.com/overleaf/overleaf"}]'

ENABLED_LINKED_FILE_TYPES=project_file,project_output_file
ENABLE_CONVERSIONS=true
EMAIL_CONFIRMATION_DISABLED=true

## Behind a TLS proxy (see overleaf-toolkit/doc/tls-proxy.md)
# OVERLEAF_BEHIND_PROXY=true
# OVERLEAF_SECURE_COOKIE=true

## Outgoing e-mail (optional; without it links are printed to the log)
# OVERLEAF_EMAIL_FROM_ADDRESS=texnest@example.com
# OVERLEAF_EMAIL_SMTP_HOST=smtp.example.com
# OVERLEAF_EMAIL_SMTP_PORT=587
# OVERLEAF_EMAIL_SMTP_SECURE=false
# OVERLEAF_EMAIL_SMTP_USER=
# OVERLEAF_EMAIL_SMTP_PASS=

EXTERNAL_AUTH=none
