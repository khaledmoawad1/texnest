# Overleaf settings loaded into the sharelatex container. Personal values and secrets go in local.env, which overrides this file.

OVERLEAF_APP_NAME="TeXnest"
OVERLEAF_NAV_TITLE=TeXnest
OVERLEAF_HEADER_IMAGE_URL=/img/texnest-lockup.svg
OVERLEAF_HEADER_IMAGE_URL_LIGHT=/img/texnest-lockup.svg
OVERLEAF_HEADER_IMAGE_URL_DARK=/img/texnest-lockup-dark.svg
OVERLEAF_SITE_URL=http://localhost:8090
OVERLEAF_ADMIN_EMAIL=admin@example.com

# Footer links; Overleaf Community Edition adds its own credits and disclaimer.
OVERLEAF_LEFT_FOOTER='[{"text":"Mailbox","url":"http://localhost:8091"},{"text":"TeXnest on GitHub","url":"https://github.com/khaledmoawad1/texnest"},{"text":"Source code (AGPL-3.0)","url":"https://github.com/overleaf/overleaf"}]'
OVERLEAF_RIGHT_FOOTER='[]'

ENABLED_LINKED_FILE_TYPES=project_file,project_output_file
ENABLE_CONVERSIONS=true
EMAIL_CONFIRMATION_DISABLED=true

# Set both when running behind the toolkit's TLS proxy (overleaf-toolkit/doc/tls-proxy.md).
# OVERLEAF_BEHIND_PROXY=true
# OVERLEAF_SECURE_COOKIE=true

# Outgoing e-mail goes to the local mailbox (http://localhost:8091) so password resets and invitations work
# without an account anywhere. Override these in local.env to use a real SMTP server instead.
OVERLEAF_EMAIL_FROM_ADDRESS=texnest@localhost
OVERLEAF_EMAIL_SMTP_HOST=mail
OVERLEAF_EMAIL_SMTP_PORT=1025
OVERLEAF_EMAIL_SMTP_SECURE=false
OVERLEAF_EMAIL_SMTP_IGNORE_TLS=true

EXTERNAL_AUTH=none
