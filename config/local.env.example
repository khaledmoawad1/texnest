# Copy to local.env (./texnest does it for you on first run). NOT tracked by git.
# Required: random secret used to sign project-invite links.
#   openssl rand -base64 32
OVERLEAF_INVITE_TOKEN_SECRET=CHANGE_ME
# Optional personal overrides (anything from variables.env can be overridden here):
# OVERLEAF_ADMIN_EMAIL=you@example.com
# OVERLEAF_SITE_URL=http://192.168.1.10
