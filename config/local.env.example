# Copy to local.env (./texnest creates it on first run). Not tracked by git.
# Secret that signs project-invite links; generate one with: openssl rand -base64 32
OVERLEAF_INVITE_TOKEN_SECRET=CHANGE_ME
# Optional personal overrides of variables.env:
# OVERLEAF_ADMIN_EMAIL=you@example.com
# OVERLEAF_SITE_URL=http://192.168.1.10:8090
# Real e-mail instead of the local mailbox (example for Gmail with an app password):
# OVERLEAF_EMAIL_FROM_ADDRESS=you@gmail.com
# OVERLEAF_EMAIL_SMTP_HOST=smtp.gmail.com
# OVERLEAF_EMAIL_SMTP_PORT=587
# OVERLEAF_EMAIL_SMTP_SECURE=false
# OVERLEAF_EMAIL_SMTP_IGNORE_TLS=false
# OVERLEAF_EMAIL_SMTP_USER=you@gmail.com
# OVERLEAF_EMAIL_SMTP_PASS=your-app-password
