#!/usr/bin/env bash
# TeXnest: one command to run your self-hosted Overleaf (./texnest help lists all commands).
#   install        first-time setup: bootstrap, build the TeX Live image, start
#   bootstrap      after a fresh clone: fetch the toolkit, link config, check
#   up | down      start (applies config changes) | stop and remove containers, data kept
#   start | stop | restart | status
#   logs [svc]     follow a service log (default web)
#   shell          root shell in the sharelatex container
#   doctor         toolkit self-check
#   selftest       upload and compile three test projects
#   backup         database dump + project files + config into backups/<stamp>/
#   restore DIR    replace everything with a backup
#   user EMAIL     create a user (prints a password-set link); admin EMAIL for an administrator
#   reset-password EMAIL   print a link to set a new password (no e-mail server needed)
#   theme P A [D]  recolor the UI from a primary and an accent (and a dark-chrome primary), then rebuild and restart
#   build-texlive  build the full TeX Live image for config/version
set -euo pipefail
ROOT="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
TK="$ROOT/overleaf-toolkit"
URL="http://localhost$( v=$(grep -E '^OVERLEAF_PORT=' "$TK/config/overleaf.rc" | cut -d= -f2); [[ "${v:-80}" == 80 ]] || echo ":$v")"

compose() { "$TK/bin/docker-compose" "$@"; }

# Config lives in ./config and is symlinked into overleaf-toolkit/config, which the toolkit ignores.
ensure_layout() {
  if [[ ! -e "$TK/bin/up" ]]; then
    echo "overleaf-toolkit/ is empty: fetching the toolkit (git submodule) ..."
    git -C "$ROOT" submodule update --init overleaf-toolkit
  fi
  mkdir -p "$TK/config" "$ROOT/logs" "$ROOT/backups" "$ROOT/migration/zips"
  if [[ ! -e "$ROOT/config/local.env" ]]; then
    printf '# Generated by ./texnest: secrets and personal overrides, not in git.\nOVERLEAF_INVITE_TOKEN_SECRET=%s\n' "$(openssl rand -base64 32 2>/dev/null || head -c 32 /dev/urandom | base64)" > "$ROOT/config/local.env"
    chmod 600 "$ROOT/config/local.env"; echo "generated config/local.env (secret + personal overrides)"
  fi
  for f in overleaf.rc variables.env version local.env docker-compose.override.yml; do
    [[ -e "$TK/config/$f" ]] || { ln -s "../../config/$f" "$TK/config/$f"; echo "linked overleaf-toolkit/config/$f -> ../../config/$f"; }
  done
}
ensure_layout

case "${1:-help}" in
  up)
    if ! docker image inspect "sharelatex/sharelatex:$(head -n1 "$TK/config/version")" >/dev/null 2>&1 \
       && [[ "$(head -n1 "$TK/config/version")" == *-with-texlive-full ]]; then
      echo "image sharelatex/sharelatex:$(head -n1 "$TK/config/version") is not built yet; run ./texnest build-texlive first (≈30 min)"; exit 1
    fi
    "$TK/bin/up" -d; echo; echo "TeXnest is at $URL"; ;;
  bootstrap) echo "layout OK: toolkit present, config linked"; "$TK/bin/doctor" | tail -n 4 ;;
  install)
    "$0" bootstrap
    "$0" build-texlive
    "$0" up
    echo; echo "Now create your admin account:  ./texnest admin you@example.com   (then open the printed link)"
    ;;
  down)     compose down ;;
  start)    "$TK/bin/start"; echo "TeXnest is at $URL" ;;
  stop)     "$TK/bin/stop" ;;
  restart)  "$TK/bin/stop"; "$TK/bin/start"; echo "TeXnest is at $URL" ;;
  status)   docker ps -a --filter name=sharelatex --filter name=mongo --filter name=redis \
              --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}'; echo; echo "URL: $URL"; ;;
  logs)     shift; "$TK/bin/logs" -f "${@:-web}" ;;
  shell)    "$TK/bin/shell" ;;
  doctor)   "$TK/bin/doctor" ;;
  selftest) python3 "$ROOT/scripts/selftest_compile.py" ;;
  user|admin)
    [[ -n "${2:-}" ]] || { echo "usage: ./texnest $1 EMAIL"; exit 1; }
    echo "creating $1 account for $2 — open the link printed at the end to set the password"
    flag=""; [[ "$1" == admin ]] && flag="--admin"
    compose exec sharelatex /bin/bash -c \
      "cd /overleaf/services/web && node modules/server-ce-scripts/scripts/create-user.mjs $flag --email='$2'"
    ;;
  reset-password)
    [[ -n "${2:-}" ]] || { echo "usage: ./texnest reset-password EMAIL   (prints a link to set a new password)"; exit 1; }
    python3 - "$URL" "$2" <<'EOF'
import json, re, sys, time, subprocess, urllib.request, http.cookiejar
base, email = sys.argv[1], sys.argv[2]
op = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(http.cookiejar.CookieJar()))
page = op.open(base + "/user/password/reset").read().decode()
csrf = re.search(r'<meta\s+name="ol-csrfToken"\s+content="([^"]+)"', page).group(1)
req = urllib.request.Request(base + "/user/password/reset", data=json.dumps({"email": email}).encode(), method="POST",
                             headers={"Content-Type": "application/json", "x-csrf-token": csrf, "Accept": "application/json"})
try:
    op.open(req)
except urllib.error.HTTPError as e:
    sys.exit(f"request failed: HTTP {e.code} {e.read().decode()[:200]}")
time.sleep(2)
log = subprocess.run(["docker", "exec", "sharelatex", "grep", "-o", r"http[^\"\\ ]*/user/password/set?[^\"\\ ]*", "/var/log/overleaf/web.log"], capture_output=True, text=True).stdout.split()
links = [l for l in log if email.replace("@", "%40") in l or email in l]
if not links:
    sys.exit("no link found: is the e-mail registered? (./texnest user EMAIL creates accounts)")
print("Open this link to choose a new password (valid for a limited time):")
print(" ", links[-1])
EOF
    ;;
  backup)
    mkdir -p "$ROOT/backups"
    stamp="$(date +%Y%m%d-%H%M%S)"
    dest="$ROOT/backups/texnest-backup-$stamp"
    mkdir -p "$dest"
    echo "1/3 dumping MongoDB (users, projects, docs, tags) ..."
    compose exec -T mongo sh -c 'rm -rf /tmp/dump && mongodump --quiet --db sharelatex --out /tmp/dump && tar -C /tmp -cf - dump' > "$dest/mongo-dump.tar"
    echo "2/3 archiving project files + history + redis (via a helper container: data dirs are root-owned) ..."
    docker run --rm -v "$TK/data:/data:ro" -v "$dest:/out" alpine:latest \
      sh -c "tar -C /data -czf /out/overleaf-data.tgz overleaf redis && chown $(id -u):$(id -g) /out/overleaf-data.tgz"
    echo "3/3 copying config ..."
    tar -C "$TK" -czf "$dest/config.tgz" config
    cp "$ROOT/texlive-full/Dockerfile" "$dest/texlive-full.Dockerfile"
    echo "backup written to $dest"; du -sh "$dest"/* | sed 's|^|   |'
    ;;
  restore)
    [[ -d "${2:-}" ]] || { echo "usage: ./texnest restore backups/texnest-backup-<stamp>   (stops Overleaf, REPLACES all data)"; exit 1; }
    src="$(realpath "$2")"
    read -r -p "This replaces ALL current Overleaf data with $src. Type yes to continue: " ans; [[ "$ans" == yes ]] || exit 1
    compose down
    docker run --rm -v "$TK/data:/data" -v "$src:/in:ro" alpine:latest \
      sh -c "rm -rf /data/overleaf /data/redis && tar -C /data -xzf /in/overleaf-data.tgz"
    tar -C "$TK" -xzf "$src/config.tgz"
    "$TK/bin/up" -d
    echo "waiting for mongo ..."; until compose exec -T mongo mongosh --quiet --eval 'db.version()' >/dev/null 2>&1; do sleep 2; done
    docker cp "$src/mongo-dump.tar" mongo:/tmp/mongo-dump.tar
    compose exec -T mongo sh -c 'cd /tmp && rm -rf dump && tar xf mongo-dump.tar && mongorestore --quiet --drop --db sharelatex /tmp/dump/sharelatex'
    "$TK/bin/docker-compose" restart sharelatex
    echo "restored from $src; TeXnest is at $URL"
    ;;
  theme)
    [[ -n "${3:-}" ]] || { echo "usage: ./texnest theme '#PRIMARY' '#ACCENT' ['#DARK_PRIMARY']   (regenerates the UI colors, rebuilds the image and restarts)"; exit 1; }
    python3 "$ROOT/branding/make_theme.py" --primary "$2" --accent "$3" ${4:+--dark-primary "$4"}
    "$0" build-texlive && "$0" up && echo "theme applied; hard-refresh the browser (Ctrl+Shift+R) once"
    ;;
  build-texlive)
    ver="$(head -n1 "$TK/config/version" | sed 's/-with-texlive-full//')"
    echo "building sharelatex/sharelatex:${ver}-with-texlive-full from base ${ver} ..."
    docker build --build-arg BASE_VERSION="$ver" --build-arg TL_MIRROR="${TL_MIRROR:-https://mirror.dogado.de/tex-archive/systems/texlive/tlnet}" \
      -t "sharelatex/sharelatex:${ver}-with-texlive-full" "$ROOT/texlive-full/" 2>&1 | tee "$ROOT/logs/build-texlive-full-$ver.log"
    echo "${ver}-with-texlive-full" > "$TK/config/version"
    echo "config/version set to ${ver}-with-texlive-full; run ./texnest up to switch to it"
    ;;
  *) sed -n "2,17p" "$0" ;;
esac
